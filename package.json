{
  "name": "@peerivo/daily-activity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Provider-neutral activity inbox and daily digest for Daily.",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
